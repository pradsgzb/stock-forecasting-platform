# Copy to .env for local development only. Never commit real credentials.
SP_APP__ENVIRONMENT=local
SP_APP__LOG_LEVEL=INFO
SP_APP__DEBUG=false

SP_STORAGE__DATA_ROOT=.local/data
SP_STORAGE__RAW_OBJECTS_SUBDIRECTORY=raw-objects
SP_STORAGE__INGESTION_CATALOG_SUBDIRECTORY=ingestion-catalog
SP_STORAGE__EXPERIMENT_EVENTS_SUBDIRECTORY=experiment-events

SP_MARKET__DEFAULT_EXCHANGE_MIC=XNYS
SP_INGESTION__MAXIMUM_PAGES=10000
SP_INGESTION__MAXIMUM_PAGE_BYTES=67108864
SP_QUALITY__RULE_SET_VERSION=price-bars-v1
SP_QUALITY__MINIMUM_ACCEPTABLE_SCORE=80
SP_QUALITY__TIMELINESS_WARNING_SECONDS=21600
SP_FEATURE_ENGINEERING__USE_POINT_IN_TIME_ADJUSTMENTS=true

SP_MODELING__MAXIMUM_HYPERPARAMETER_TRIALS=100
SP_MODELING__CALIBRATION_BINS=10
SP_MODELING__ALLOW_TRUSTED_MODEL_DESERIALIZATION=false
SP_MODELING__BACKTESTING_ONLY=true
SP_INFERENCE__MAXIMUM_BATCH_SIZE=10000
SP_FEATURES__ENABLE_FUTURE_ONLINE_INFERENCE=false
SP_FEATURES__ENABLE_FUTURE_LIVE_TRADING=false
SP_MONITORING__MINIMUM_SAMPLES=30
SP_MONITORING__HISTOGRAM_BINS=10
SP_CONTINUOUS_TRAINING__MINIMUM_OUTCOMES=30
SP_CONTINUOUS_TRAINING__MINIMUM_IMPROVEMENT=0.01
SP_CONTINUOUS_TRAINING__ALLOW_AUTOMATIC_PROMOTION=false

SP_SECURITY__SECRET_BACKEND=environment
# SP_SECURITY__MARKET_DATA_API_KEY=

SP_DATABASE__URL=sqlite+pysqlite:///.local/data/operations.db
SP_DATABASE__ECHO=false
SP_API__ENABLED=true
SP_API__HOST=127.0.0.1
SP_API__PORT=8080
SP_API__REQUEST_BODY_LIMIT_BYTES=1048576
SP_API__RATE_LIMIT_REQUESTS=120
SP_API__RATE_LIMIT_WINDOW_SECONDS=60
SP_API__RATE_LIMIT_MAXIMUM_CLIENTS=10000
SP_API__ALLOWED_HOSTS='["localhost","127.0.0.1","testserver"]'
SP_API__DOCS_ENABLED=true
SP_API__JWT_ISSUER=https://local.identity.invalid/
SP_API__JWT_AUDIENCE=stock-forecasting-platform
SP_API__JWT_ALGORITHMS='["RS256"]'
SP_API__JWT_VERIFICATION_KEY_PATH=.local/secrets/jwt-public.pem

SP_PAPER_TRADING__SPREAD_BPS=5
SP_PAPER_TRADING__SLIPPAGE_BPS=2
SP_PAPER_TRADING__COMMISSION_BPS=1
SP_PAPER_TRADING__MAXIMUM_ORDER_NOTIONAL=1000000
SP_PAPER_TRADING__MAXIMUM_POSITION_NOTIONAL=2000000
SP_OBSERVABILITY__METRICS_NAMESPACE=stock_predictor
SP_OBSERVABILITY__SERVICE_NAME=stock-forecasting-platform

# Docker Compose-only values. Replace every placeholder before starting containers.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
MINIO_ROOT_USER=replace-with-a-local-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-password
GRAFANA_ADMIN_USER=replace-with-a-local-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-local-password
API_PORT=8080
DEBUG_API_PORT=8081
DEBUG_PORT=5678
